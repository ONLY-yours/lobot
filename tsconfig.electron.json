{
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "target": "ESNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "composite": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./electron/main/*"],
      "~common/*": ["./electron/common/*"],
      "*": ["./*"]
    }
  },
  "include": [
    "src/libs/mcp/__tests__/fixtures/negotiationServers.ts",
    "electron/main/**/*",
    "electron/main/global.d.ts",
    "electron/preload/**/*",
    "electron/common/**/*",
    "electron-builder.js",
    "native-deps.config.js"
  ]
}
